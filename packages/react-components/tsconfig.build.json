{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": true,
    "isolatedDeclarations": true,
    "types": ["react", "react-dom"]
  },
  "include": [
    "src/index.ts",
    "src/vite-env.d.ts",
    "src/components/**/*",
    "src/hooks/**/*",
    "src/utils/**/*"
  ],
  "exclude": ["src/**/*.figma.ts", "src/**/*.test.ts", "src/**/*.test.tsx"]
}
