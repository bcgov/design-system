{
  "name": "@bcgov/design-system-react-components",
  "version": "0.9.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bcgov/design-system.git",
    "directory": "packages/react-components"
  },
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist",
    "build:js": "vite build -c vite.lib.config.ts",
    "build:dts": "rolldown -c rolldown.dts.config.ts",
    "typecheck": "tsc -p tsconfig.build.json",
    "build": "npm run clean && npm run build:js && npm run build:dts && npm run typecheck",
    "format:check": "npx prettier . --check",
    "format": "npx prettier . --write",
    "lint": "npm run lint:ts && npm run lint:css",
    "lint:ts": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:css": "stylelint \"src/**/*.css\"",
    "storybook-dev": "storybook dev -p 6006",
    "storybook-build": "storybook build",
    "test": "npx vitest --project=unit --watch=false",
    "test:watch": "npx vitest --project=unit",
    "test-storybook": "npx vitest --project=storybook --watch=false",
    "test-storybook:watch": "npx vitest --project=storybook",
    "vite-dev": "vite",
    "vite-build": "tsc && vite build",
    "vite-preview": "vite preview"
  },
  "main": "dist/cjs/index.cjs",
  "module": "dist/esm/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    }
  },
  "files": [
    "AGENTS.md",
    "dist/index.d.ts",
    "dist/esm",
    "dist/cjs"
  ],
  "dependencies": {
    "@bcgov/design-tokens": "5.1.0",
    "@react-aria/datepicker": "3.17.1",
    "react-aria": "3.53.1",
    "react-aria-components": "1.22.1"
  },
  "peerDependencies": {
    "@bcgov/bc-sans": "^2.1.0",
    "react": "^16.14.0 || ^17.0.0-rc.1 || ^18.0.0 || ^19.0.0",
    "react-dom": "^16.14.0 || ^17.0.0-rc.1 || ^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@figma/code-connect": "2.1.0",
    "@internationalized/date": "3.12.4",
    "@storybook/addon-a11y": "10.6.6",
    "@storybook/addon-docs": "10.6.6",
    "@storybook/addon-links": "10.6.6",
    "@storybook/addon-mcp": "10.6.6",
    "@storybook/addon-vitest": "10.6.6",
    "@storybook/mcp": "10.6.6",
    "@storybook/react-vite": "10.6.6",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.72.2",
    "@typescript-eslint/parser": "8.72.2",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-storybook": "10.6.6",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "playwright": "1.65.0",
    "prettier": "3.10.0",
    "rolldown": "1.3.2",
    "rolldown-plugin-dts": "0.30.2",
    "storybook": "10.6.6",
    "stylelint": "18.0.0",
    "stylelint-config-standard": "41.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.7",
    "vite-plugin-css-injected-by-js": "5.0.3",
    "vitest": "5.1.0"
  },
  "overrides": {
    "eslint-plugin-react-hooks": {
      "zod-validation-error": "^4.0.0"
    }
  },
  "author": "Tyler Krys <Tyler.Krys@gov.bc.ca>",
  "contributors": [
    "Marcus Kernohan <Marcus.Kernohan@gov.bc.ca>",
    "Trevor Richards <Trevor.Richards@gov.bc.ca>"
  ],
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/bcgov/design-system/issues"
  },
  "homepage": "https://github.com/bcgov/design-system#readme",
  "private": false
}
